# TrustLens AI assistant (optional).
#
# Copy this file to .env and add a key. Without a key, the assistant still
# answers from the built-in safety guide, but it cannot understand questions
# outside that guide.
#
# The backend accepts any OpenAI-compatible endpoint. Use ONE of the two
# options below and keep this file out of version control.

# --- Option 1: Freebuff gateway (OpenAI-compatible) ---
# Create a key at https://freebuff.com/account/api (Account -> Developer API).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://freebuff.com/api/v1/paid
AI_MODEL=gpt-4o-mini

# --- Option 2: OpenAI directly ---
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=
# AI_MODEL=gpt-4o-mini
